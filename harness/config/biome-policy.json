{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "style": {
        "noDefaultExport": "error"
      }
    }
  },
  "javascript": {
    "globals": ["Buffer", "process"]
  },
  "overrides": [
    {
      "includes": ["**/eslint.config.mjs"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
