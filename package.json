{
  "name": "fleetiq-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "check": "pnpm floor && pnpm check:fast && pnpm build && pnpm test:coverage && pnpm security",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "build": "tsc --rootDir src --outDir dist --rewriteRelativeImportExtensions",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "test:coverage": "node tools/coverage.mjs && pnpm test:bounds",
    "security": "pnpm secrets && pnpm audit --audit-level high",
    "secrets": "node tools/secrets.mjs",
    "check:fast": "pnpm lint && pnpm typecheck && pnpm architecture",
    "lint": "biome ci . --error-on-warnings && pnpm lint:comments && pnpm lint:source-comments",
    "lint:comments": "eslint tools",
    "architecture": "node tools/architecture.mjs",
    "floor": "node tools/floor.mjs",
    "test:platform": "node tools/platform-decoder.mjs",
    "test:reference": "node --test tests/codec8-oracle.test.ts tests/udp.test.ts tests/codec16.test.ts && pnpm test:reference:codec12",
    "test:reference:codec12": "node --test tests/codec12.test.ts",
    "image:qualify": "node tools/image-qualify.mjs",
    "lint:source-comments": "eslint src",
    "test:bounds": "node tools/fleet-bounds.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.10.1",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "10.14.0",
    "eslint-plugin-jsdoc": "65.4.5",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
