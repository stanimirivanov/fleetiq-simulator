{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.mjs",
    "tools/**/*.mjs",
    "packaging/**/*.mjs",
    "harness/src/**/*.mjs",
    "harness/tests/**/*.mjs",
    "harness/support/**/*.mjs",
    "harness/config/**/*.mjs"
  ]
}
